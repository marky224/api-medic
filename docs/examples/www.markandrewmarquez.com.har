position: 0 80px, 80px 0; }\n    }\n    @keyframes tron-scan {\n      0% { transform: translateY(-100%); }\n      100% { transform: translateY(100vh); }\n    }\n    @keyframes tron-pulse-glow {\n      0%, 100% { box-shadow: 0 0 0 1px #4df0ff40, 0 0 24px #4df0ff30, inset 0 0 20px #4df0ff10; }\n      50% { box-shadow: 0 0 0 1px #4df0ff, 0 0 40px #4df0ff50, inset 0 0 30px #4df0ff20; }\n    }\n    @keyframes tron-caret { 0%,49%{opacity:1} 50%,100%{opacity:0} }\n    @keyframes tron-flicker {\n      0%, 100% { opacity: 1; }\n      50% { opacity: 0.88; }\n      52% { opacity: 1; }\n    }\n    @keyframes tron-line-run {\n      0% { transform: translateX(-100%); }\n      100% { transform: translateX(100%); }\n    }\n    .tron-svc:hover .tron-svc-inner {\n      background: #090f1a !important;\n      box-shadow: 0 0 0 1px #4df0ff, 0 0 40px #4df0ff30 !important;\n    }\n    .tron-svc:hover .tron-corner { border-color: #4df0ff !important; }\n    .tron-svc:hover .tron-svc-num { color: #4df0ff !important; text-shadow: 0 0 18px #4df0ff !important; }\n    .tron-portfolio-card:hover .tron-portfolio-overlay { opacity: 1 !important; }\n    .tron-portfolio-card:hover .tron-portfolio-img { transform: scale(1.06); filter: saturate(1.3) contrast(1.15); }\n    .tron-portfolio-card:hover { box-shadow: 0 0 0 1px #4df0ff, 0 0 32px #4df0ff40 !important; }\n    .tron-cta-primary { position: relative; overflow: hidden; }\n    .tron-cta-primary::after {\n      content: ''; position: absolute; inset: 0;\n      background: linear-gradient(90deg, transparent, #4df0ff40, transparent);\n      transform: translateX(-100%); transition: transform .8s ease;\n    }\n    .tron-cta-primary:hover::after { transform: translateX(100%); }\n    .tron-link:hover { color: #4df0ff !important; text-shadow: 0 0 12px #4df0ff; }\n    .tron-chip:hover { border-color: #4df0ff !important; color: #4df0ff !important; box-shadow: 0 0 12px #4df0ff40; }\n    html { scroll-behavior: smooth; }\n  </style></head>\n<body style=\"cursor: crosshair; background-color: rgb(0, 0, 0);\" data-cc-id=\"cc-1\">\n<div id=\"root\"><div id=\"top\" style=\"background:#000309;min-height:100%;color:#d6f2ff\"><nav style=\"position:sticky;top:0;z-index:100;background:rgba(0,3,9,0.88);backdrop-filter:blur(12px);border-bottom:1px solid #0d3547;padding:14px 56px\"><div style=\"max-width:1280px;margin:0 auto;display:flex;align-items:center;justify-content:space-between\"><a href=\"#top\" style=\"display:flex;align-items:center;gap:10px;text-decoration:none\"><div style=\"width:22px;height:22px;position:relative;clip-path:polygon(50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%, 0 25%);background:#4df0ff;display:flex;align-items:center;justify-content:center;color:#000309;font-family:&#x27;JetBrains Mono&#x27;, &#x27;Share Tech Mono&#x27;, ui-monospace, monospace;font-size:11px;font-weight:700;box-shadow:0 0 20px #4df0ff\">M</div><span style=\"font-family:&#x27;Orbitron&#x27;, &#x27;Rajdhani&#x27;, &#x27;Inter&#x27;, system-ui, sans-serif;font-size:14px;color:#d6f2ff;font-weight:600;letter-spacing:2px;text-transform:uppercase\">Mark <span style=\"color:#4df0ff;text-shadow:0 0 10px #4df0ff\">Marquez</span></span></a><div style=\"display:flex;gap:28px;align-items:center\"><a href=\"#about\" class=\"tron-link\" style=\"font-family:&#x27;JetBrains Mono&#x27;, &#x27;Share Tech Mono&#x27;, ui-monospace, monospace;font-size:11px;color:#8fb8cc;text-decoration:none;letter-spacing:2px;text-transform:uppercase;transition:all .15s\">./about</a><a href=\"#skills\" class=\"tron-link\" style=\"font-family:&#x27;JetBrains Mono&#x27;, &#x27;Share Tech Mono&#x27;, ui-monospace, monospace;font-size:11px;color:#8fb8cc;text-decoration:none;letter-spacing:2px;text-transform:uppercase;transition:all .15s\">./skills</a><a href=\"#portfolio\" class=\"tron-link\" style=\"font-family:&#x27;JetBrains Mono&#x27;, &#x27;Share Tech Mono&#x27;, ui-monospace, monospace;font-size:11px;color:#8fb8cc;text-decoration:none;letter-spacing:2px;text-transform:uppercase;transition:all .15s\">./portfolio</a><a href=\"#contact\" style=\"font-family:&#x27;JetBrains Mono&#x27;, &#x27;Share Tech Mono&#x27;, ui-monospace, monospace;font-size:11px;letter-spacing:2px;text-transform:uppercase;padding:9px 16px;background:#4df0ff;color:#000309;border:none;cursor:pointer;font-weight:700;text-decoration:none;display:inline-block;box-shadow:0 0 16px #4df0ff80\">▸ Contact</a></div></div></nav><section style=\"position:relative;padding:100px 56px 120px;overflow:hidden;background:#000309\"><div aria-hidden=\"true\" style=\"position:absolute;bottom:0;left:0;right:0;height:60%;background-image:linear-gradient(#4df0ff35 1px, transparent 1px), linear-gradient(90deg, #4df0ff35 1px, transparent 1px);background-size:80px 80px;transform:perspective(600px) rotateX(60deg);transform-origin:bottom;mask-image:linear-gradient(to top, black, transparent 85%);-webkit-mask-image:linear-gradient(to top, black, transparent 85%);animation:tron-grid-drift 8s linear infinite\"></div><div aria-hidden=\"true\" style=\"position:absolute;top:45%;left:0;right:0;height:1px;background:linear-gradient(90deg, transparent, #4df0ff, transparent);box-shadow:0 0 40px #4df0ff, 0 0 80px #4df0ff60\"></div><div aria-hidden=\"true\" style=\"position:absolute;inset:0;pointer-events:none;background:radial-gradient(ellipse at center, transparent 40%, #000309 95%)\"></div><div style=\"position:relative;max-width:1280px;margin:0 auto;display:grid;grid-template-columns:1.15fr 1fr;gap:64px;align-items:center\"><div><div style=\"display:flex;align-items:center;gap:10px;margin-bottom:24px\"><div style=\"width:8px;height:8px;background:#4df0ff;border-radius:2px;box-shadow:0 0 12px #4df0ff, 0 0 24px #4df0ff60;animation:tron-flicker 3s infinite\"></div><span style=\"font-family:&#x27;JetBrains Mono&#x27;, &#x27;Share Tech Mono&#x27;, ui-monospace, monospace;font-size:11px;color:#4df0ff;letter-spacing:2.5px;text-transform:uppercase;font-weight:500;text-shadow:0 0 10px #4df0ff\">System online · Open to remote TSE roles</span></div><h1 style=\"font-family:&#x27;Orbitron&#x27;, &#x27;Rajdhani&#x27;, &#x27;Inter&#x27;, system-ui, sans-serif;font-size:clamp(56px, 7.5vw, 96px);line-height:0.98;letter-spacing:1px;color:#d6f2ff;font-weight:500;margin:0 0 28px;text-transform:uppercase\">I solve hard tickets.<br/><span style=\"color:#4df0ff;text-shadow:0 0 20px #4df0ff, 0 0 40px #4df0ff80;font-weight:600\">Then I automate them away.</span></h1><p style=\"font-family:&#x27;Rajdhani&#x27;, &#x27;Inter&#x27;, system-ui, sans-serif;font-size:20px;line-height:1.55;font-weight:400;color:#8fb8cc;max-width:560px;margin:0 0 40px\">Technical Support Engineer. 96.6% CSAT, top closer 8 of 10 months at an AI service desk platform. Generalist stack — Windows/Linux, M365/Azure/AWS, REST APIs, scripting, agentic AI. Tier 2+ across the board. Open to remote roles.</p><div style=\"display:flex;gap:12px;flex-wrap:wrap\"><a href=\"#contact\" class=\"tron-cta-primary\" style=\"font-family:&#x27;JetBrains Mono&#x27;, &#x27;Share Tech Mono&#x27;, ui-monospace, monospace;font-size:13px;letter-spacing:2px;text-transform:uppercase;padding:16px 26px;background:#4df0ff;color:#000309;border:none;cursor:pointer;font-weight:700;text-decoration:none;clip-path:polygon(0 0, calc(100% - 14px) 0, 100% 14px, 100% 100%, 14px 100%, 0 calc(100% - 14px));box-shadow:0 0 30px #4df0ff80, 0 0 60px #4df0ff40\">▸ Get in touch</a></div></div><div style=\"position:relative\"><div class=\"tron-corner\" style=\"position:absolute;width:20px;height:20px;border-color:#4df0ff;border-style:solid;border-width:0;transition:border-color .2s;top:-1px;left:-1px;border-top-width:1.5px;border-left-width:1.5px\"></div><div class=\"tron-corner\" style=\"position:absolute;width:20px;height:20px;border-color:#4df0ff;border-style:solid;border-width:0;transition:border-color .2s;top:-1px;right:-1px;border-top-width:1.5px;border-right-width:1.5px\"></div><div class=\"tron-corner\" style=\"position:absolute;width:20px;height:20px;border-color:#4df0ff;border-style:solid;border-width:0;transition:border-color .2s;bottom:-1px;left:-1px;border-bottom-width:1.5px;border-left-width:1.5px\"></div><div class=\"tron-corner\" style=\"position:absolute;width:20px;height:20px;border-color:#4df0ff;border-style:solid;border-width:0;transition:border-color .2s;bottom:-1px;right:-1px;border-bottom-width:1.5px;border-right-width:1.5px\"></div><div style=\"background:#05080f;border:1px solid #16647f;box-shadow:0 0 60px #4df0ff30, inset 0 0 80px #4df0ff08;clip-path:polygon(0 0, calc(100% - 24px) 0, 100% 24px, 100% 100%, 24px 100%, 0 calc(100% - 24px))\"><div style=\"display:flex;align-items:center;justify-content:space-between;padding:12px 18px;border-bottom:1px solid #0d3547;background:#090f1a\"><div style=\"display:flex;align-items:center;gap:8px\"><div style=\"width:18px;height:18px;position:relative;clip-path:polygon(50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%, 0 25%);background:#4df0ff;display:flex;align-items:center;justify-content:center;color:#000309;font-family:&#x27;JetBrains Mono&#x27;, &#x27;Share Tech Mono&#x27;, ui-monospace, monospace;font-size:11px;font-weight:700;box-shadow:0 0 20px #4df0ff\">M</div><span style=\"font-family:&#x27;JetBrains Mono&#x27;, &#x27;Share Tech Mono&#x27;, ui-monospace, monospace;font-size:11px;color:#8fb8cc;letter-spacing:1.5px;text-transform:uppercase\">grid://mark.sys — session 0xA1B2</span></div><div style=\"display:flex;gap:6px\"><span style=\"width:6px;height:6px;background:#4df0ff;box-shadow:0 0 8px #4df0ff\"></span><span style=\"width:6px;height:6px;background:#ff7a18;box-shadow:0 0 8px #ff7a18\"></span><span style=\"width:6px;height:6px;background:#5a8fa6\"></span></div></div><div style=\"padding:22px 24px;min-height:310px\"><div style=\"display:flex;gap:10px;font-family:&#x27;JetBrains Mono&#x27;, &#x27;Share Tech Mono&#x27;, ui-monospace, monospace;font-size:13px\"><span style=\"color:#4df0ff\">▸</span><span style=\"color:#8fb8cc\">mark@grid</span><span style=\"color:#5a8fa6\">:</span><span style=\"color:#ff7a18\">~/grid</span><span style=\"color:#5a8fa6\">$</span><span style=\"display:inline-block;width:9px;height:16px;background:#4df0ff;box-shadow:0 0 10px #4df0ff;animation:tron-caret 1s infinite\"></span></div></div></div></div></div></section><section id=\"about\" style=\"padding:120px 56px;background:#000309;border-top:1px solid #0d3547;position:relative;overflow:hidden\"><div aria-hidden=\"true\" style=\"position:absolute;inset:0;background-image:linear-gradient(#4df0ff08 1px, transparent 1px), linear-gradient(90deg, #4df0ff08 1px, transparent 1px);background-size:60px 60px;mask-image:radial-gradient(ellipse at 30% 50%, black, transparent 75%);-webkit-mask-image:radial-gradient(ellipse at 30% 50%, black, transparent 75%)\"></div><div style=\"max-width:1100px;margin:0 auto;position:relative;display:grid;grid-template-columns:280px 1fr;gap:64px;align-items:start\"><div><div style=\"position:relative;width:260px;height:260px\"><div aria-hidden=\"true\" style=\"position:absolute;inset:0;background:#4df0ff;clip-path:polygon(50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%, 0 25%);box-shadow:0 0 50px #4df0ff60\"></div><div aria-hidden=\"true\" style=\"position:absolute;inset:3px;background:#000309;clip-path:polygon(50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%, 0 25%)\"></div><div style=\"position:absolute;inset:8px;clip-path:polygon(50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%, 0 25%);overflow:hidden\"><img src=\"assets/headshot.png\" alt=\"Mark Marquez\" style=\"width:100%;height:100%;object-fit:cover;display:block;filter:contrast(1.05) saturate(.9)\"/></div></div><div style=\"margin-top:22px;font-family:&#x27;JetBrains Mono&#x27;, &#x27;Share Tech Mono&#x27;, ui-monospace, monospace;font-size:11px;color:#5a8fa6;letter-spacing:1.5px;text-transform:uppercase\">▸ San Antonio Grid</div></div><div><span style=\"font-family:&#x27;JetBrains Mono&#x27;, &#x27;Share Tech Mono&#x27;, ui-monospace, monospace;font-size:11px;color:#4df0ff;letter-spacing:2.5px;text-transform:uppercase;font-weight:500;text-shadow:0 0 10px #4df0ff\">// about</span><h2 style=\"font-family:&#x27;Orbitron&#x27;, &#x27;Rajdhani&#x27;, &#x27;Inter&#x27;, system-ui, sans-serif;font-size:clamp(36px, 4.5vw, 56px);line-height:1.05;letter-spacing:1px;color:#d6f2ff;font-weight:500;text-transform:uppercase;margin:16px 0 28px\">Mark Marquez</h2><p style=\"font-family:&#x27;Rajdhani&#x27;, &#x27;Inter&#x27;, system-ui, sans-serif;font-size:19px;line-height:1.65;color:#d6f2ff;margin:0 0 20px\">Technical Support Engineer with years of experience across IT, cybersecurity, SaaS operations, and emerging AI tooling. Time in the weeds — supporting real users, hardening real networks, shipping automation that saved real hours. I&#x27;m happiest when a hard ticket lands on my desk.</p><p style=\"font-family:&#x27;Rajdhani&#x27;, &#x27;Inter&#x27;, system-ui, sans-serif;font-size:17px;line-height:1.7;color:#8fb8cc;margin:0 0 32px\">Today I work at the intersection of classical IT and agentic AI — helping teams go from &quot;we should automate that&quot; to running workflows their staff actually trust. Also: neuroscience research assistant, amateur home-lab operator, perpetual tinkerer.</p><div style=\"display:flex;align-items:center;flex-wrap:wrap;gap:10px;margin:0 0 28px\"><span style=\"font-family:&#x27;JetBrains Mono&#x27;, &#x27;Share Tech Mono&#x27;, ui-monospace, monospace;font-size:11px;color:#ff7a18;letter-spacing:2px;text-transform:uppercase\">● Languages</span><span style=\"font-family:&#x27;JetBrains Mono&#x27;, &#x27;Share Tech Mono&#x27;, ui-monospace, monospace;font-size:12.5px;color:#d6f2ff;padding:6px 11px;background:#090f1a;border:1px solid #0d3547\">English</span><span style=\"font-family:&#x27;JetBrains Mono&#x27;, &#x27;Share Tech Mono&#x27;, ui-monospace, monospace;font-size:12.5px;color:#d6f2ff;padding:6px 11px;background:#090f1a;border:1px solid #0d3547\">Spanish (bilingual)</span></div><div style=\"display:flex;gap:12px;flex-wrap:wrap\"><a href=\"https://github.com/marky224\" target=\"_blank\" rel=\"noopener\" style=\"font-family:&#x27;JetBrains Mono&#x27;, &#x27;Share Tech Mono&#x27;, ui-monospace, monospace;font-size:12px;color:#d6f2ff;letter-spacing:1.5px;padding:12px 18px;background:#05080f;border:1px solid #0d3547;text-decoration:none;display:inline-flex;align-items:center;gap:10px;text-transform:uppercase\" class=\"tron-chip\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 .5C5.4.5 0 5.9 0 12.5c0 5.3 3.4 9.7 8.2 11.3.6.1.8-.3.8-.6v-2.1c-3.3.7-4-1.6-4-1.6-.5-1.4-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11 11 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.7-2.8 5.7-5.5 6 .4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6 4.8-1.6 8.2-6 8.2-11.3C24 5.9 18.6.5 12 .5z\"></path></svg>GitHub</a><a href=\"https://www.linkedin.com/in/markandrewmarquez/\" target=\"_blank\" rel=\"noopener\" style=\"font-family:&#x27;JetBrains Mono&#x27;, &#x27;Share Tech Mono&#x27;, ui-monospace, monospace;font-size:12px;color:#d6f2ff;letter-spacing:1.5px;padding:12px 18px;background:#05080f;border:1px solid #0d3547;text-decoration:none;display:inline-flex;align-items:center;gap:10px;text-transform:uppercase\" class=\"tron-chip\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M20.5 2h-17A1.5 1.5 0 0 0 2 3.5v17A1.5 1.5 0 0 0 3.5 22h17a1.5 1.5 0 0 0 1.5-1.5v-17A1.5 1.5 0 0 0 20.5 2zM8 19H5V9h3v10zM6.5 7.7a1.75 1.75 0 1 1 0-3.5 1.75 1.75 0 0 1 0 3.5zM19 19h-3v-5.3c0-1.3-.5-2-1.6-2-1.2 0-1.9.8-1.9 2V19h-3V9h2.9v1.3c.6-.9 1.6-1.6 3.1-1.6 2.4 0 3.5 1.3 3.5 3.9V19z\"></path></svg>LinkedIn</a></div></div></div></section><section id=\"skills\" style=\"padding:120px 56px;background:#000309;position:relative\"><div style=\"max-width:1280px;margin:0 auto\"><div style=\"display:flex;align-items:center;gap:20px;margin-bottom:48px\"><span style=\"font-family:&#x27;JetBrains Mono&#x27;, &#x27;Share Tech Mono&#x27;, ui-monospace, monospace;font-size:11px;color:#4df0ff;letter-spacing:2.5px;text-transform:uppercase;font-weight:500;text-shadow:0 0 10px #4df0ff\">// skills</span><div style=\"flex:1\"><div style=\"position:relative;height:1px;background:#0d3547;overflow:hidden\"><div style=\"position:absolute;inset:0;width:40%;background:linear-gradient(90deg, transparent, #4df0ff, transparent);animation:tron-line-run 4s linear infinite\"></div></div></div><span style=\"font-family:&#x27;JetBrains Mono&#x27;, &#x27;Share Tech Mono&#x27;, ui-monospace, monospace;font-size:11px;color:#4df0ff;letter-spacing:2.5px;text-transform:uppercase;font-weight:500;text-shadow:none\">06 domains</span></div><h2 style=\"font-family:&#x27;Orbitron&#x27;, &#x27;Rajdhani&#x27;, &#x27;Inter&#x27;, system-ui, sans-serif;font-size:clamp(40px, 5vw, 64px);line-height:1.05;letter-spacing:1px;color:#d6f2ff;font-weight:500;text-transform:uppercase;margin:0 0 64px;max-width:820px\">What I bring to a <span style=\"color:#4df0ff;text-shadow:0 0 18px #4df0ff\">support team.</span></h2><div style=\"display:grid;grid-template-columns:repeat(2, 1fr);gap:20px\"><div class=\"tron-svc\" style=\"position:relative;cursor:default\"><div class=\"tron-corner\" style=\"position:absolute;width:14px;height:14px;border-color:#4df0ff;border-style:solid;border-width:0;transition:border-color .2s;top:-1px;left:-1px;border-top-width:1.5px;border-left-width:1.5px\"></div><div class=\"tron-corner\" style=\"position:absolute;width:14px;height:14px;border-color:#4df0ff;border-style:solid;border-width:0;transition:border-color .2s;top:-1px;right:-1px;border-top-width:1.5px;border-right-width:1.5px\"></div><div class=\"tron-corner\" style=\"position:absolute;width:14px;height:14px;border-color:#4df0ff;border-style:solid;border-width:0;transition:border-color .2s;bottom:-1px;left:-1px;border-bottom-width:1.5px;border-left-width:1.5px\"></div><div class=\"tron-corner\" style=\"position:absolute;width:14px;height:14px;border-color:#4df0ff;border-style:solid;border-width:0;transition:border-color .2s;bottom:-1px;right:-1px;border-bottom-width:1.5px;border-right-width:1.5px\"></div><div class=\"tron-svc-inner\" style=\"background:#05080f;border:1px solid #0d3547;padding:32px 32px 28px;transition:all .25s;clip-path:polygon(0 0, calc(100% - 18px) 0, 100% 18px, 100% 100%, 18px 100%, 0 calc(100% - 18px))\"><div style=\"display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:20px\"><span class=\"tron-svc-num\" style=\"font-family:&#x27;Orbitron&#x27;, &#x27;Rajdhani&#x27;, &#x27;Inter&#x27;, system-ui, sans-serif;font-size:52px;font-weight:400;color:#16647f;line-height:0.9;transition:all .25s\">01</span><span style=\"font-family:&#x27;JetBrains Mono&#x27;, &#x27;Share Tech Mono&#x27;, ui-monospace, monospace;font-size:11px;color:#ff7a18;letter-spacing:2.5px;text-transform:uppercase;font-weight:500;text-shadow:none\">.debug</span></div><h3 style=\"font-family:&#x27;Orbitron&#x27;, &#x27;Rajdhani&#x27;, &#x27;Inter&#x27;, system-ui, sans-serif;font-size:24px;font-weight:500;letter-spacing:0.5px;text-transform:uppercase;color:#d6f2ff;margin:0 0 12px\">Troubleshooting &amp; Diagnostics</h3><p style=\"font-family:&#x27;Rajdhani&#x27;, &#x27;Inter&#x27;, system-ui, sans-serif;font-size:16px;line-height:1.6;color:#8fb8cc;margin:0 0 22px\">Diagnose vague tickets fast — logs, curl, DevTools, Wireshark, SQL debug. Reproduce, isolate, root-cause, document, then escalate with evidence so the next tier loses no time.</p><div style=\"display:flex;flex-wrap:wrap;gap:6px\"><span style=\"font-family:&#x27;JetBrains Mono&#x27;, &#x27;Share Tech Mono&#x27;, ui-monospace, monospace;font-size:10.5px;color:#4df0ff;padding:5px 10px;background:#4df0ff10;border:1px solid #4df0ff40;letter-spacing:1px;text-transform:uppercase\">Log Analysis</span><span style=\"font-family:&#x27;JetBrains Mono&#x27;, &#x27;Share Tech Mono&#x27;, ui-monospace, monospace;font-size:10.5px;color:#4df0ff;padding:5px 10px;background:#4df0ff10;border:1px solid #4df0ff40;letter-spacing:1px;text-transform:uppercase\">curl</span><span style=\"font-family:&#x27;JetBrains Mono&#x27;, &#x27;Share Tech Mono&#x27;, ui-monospace, monospace;font-size:10.5px;color:#4df0ff;padding:5px 10px;background:#4df0ff10;border:1px solid #4df0ff40;letter-spacing:1px;text-transform:uppercase\">DevTools</span><span style=\"font-family:&#x27;JetBrains Mono&#x27;, &#x27;Share Tech Mono&#x27;, ui-monospace, monospace;font-size:10.5px;color:#4df0ff;padding:5px 10px;background:#4df0ff10;border:1px solid #4df0ff40;letter-spacing:1px;text-transform:uppercase\">Wireshark</span><span style=\"font-family:&#x27;JetBrains Mono&#x27;, &#x27;Share Tech Mono&#x27;, ui-monospace, monospace;font-size:10.5px;color:#4df0ff;padding:5px 10px;background:#4df0ff10;border:1px solid #4df0ff40;letter-spacing:1px;text-transform:uppercase\">SQL Debug</span><span style=\"font-family:&#x27;JetBrains Mono&#x27;, &#x27;Share Tech Mono&#x27;, ui-monospace, monospace;font-size:10.5px;color:#4df0ff;padding:5px 10px;background:#4df0ff10;border:1px solid #4df0ff40;letter-spacing:1px;text-transform:uppercase\">Root-Cause</span></div></div></div><div class=\"tron-svc\" style=\"position:relative;cursor:default\"><div class=\"tron-corner\" style=\"position:absolute;width:14px;height:14px;border-color:#4df0ff;border-style:solid;border-width:0;transition:border-color .2s;top:-1px;left:-1px;border-top-width:1.5px;border-left-width:1.5px\"></div><div class=\"tron-corner\" style=\"position:absolute;width:14px;height:14px;border-color:#4df0ff;border-style:solid;border-width:0;transition:border-color .2s;top:-1px;right:-1px;border-top-width:1.5px;border-right-width:1.5px\"></div><div class=\"tron-corner\" style=\"position:absolute;width:14px;height:14px;border-color:#4df0ff;border-style:solid;border-width:0;transition:border-color .2s;bottom:-1px;left:-1