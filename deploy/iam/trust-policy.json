{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GitHubActionsOIDC",
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::444977504043:oidc-provider/token.actions.githubusercontent.com"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
          "token.actions.githubusercontent.com:sub": [
            "repo:marky224/api-medic:ref:refs/heads/main",
            "repo:marky224/api-medic:environment:demo"
          ],
          "token.actions.githubusercontent.com:job_workflow_ref": "marky224/api-medic/.github/workflows/deploy-demo.yml@refs/heads/main"
        }
      }
    }
  ]
}
