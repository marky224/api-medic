{
  "manifest_version": 3,
  "name": "api-medic",
  "version": "0.1.0",
  "description": "Diagnose HTTP requests captured in DevTools — analysis runs on the api-medic hosted demo.",
  "devtools_page": "devtools.html",
  "host_permissions": [
    "https://api-medic.markandrewmarquez.com/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "api-medic@markandrewmarquez.com",
      "strict_min_version": "115.0"
    }
  }
}
